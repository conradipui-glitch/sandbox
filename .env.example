# Клиентская часть не требует секретов.
# Workers AI и Durable Objects подключаются через bindings в wrangler.jsonc.

# B11 Engine integration is opt-in. Keep `off` until the B11 semantic gate is GREEN.
ENGINE_FLORENCE_ROLLOUT=off

# Test/runtime BFF target. This is not a secret; credentials for individual Engine
# sessions are created server-side and stored only in RUNTIME_ROUTE_SESSIONS.
ENGINE_RUNTIME_URL=http://127.0.0.1:8787
ENGINE_FLORENCE_PROJECT_ID=living-history
ENGINE_FLORENCE_QUEST_ID=florence-workshop
